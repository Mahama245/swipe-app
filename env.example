<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SWIPE — encoded messaging</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/mathjs/12.4.2/math.min.js"></script>
<script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
<script src="https://unpkg.com/@simplewebauthn/browser@11/dist/bundle/index.umd.min.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');

:root{
  --bg:#17151C;
  --panel:#211E29;
  --panel-alt:#2A2733;
  --border:#38333F;
  --text:#EDE9F2;
  --muted:#9A93A8;
  --accent:#B98CFF;
  --accent-soft:#6B5A8C;
  --accent-dim:#453A5C;
  --bubble-me:#4A3B66;
  --bubble-them:#2C2833;
  --ok:#7FE0C4;
  --ok-dim:#1c3a34;
  --warn:#F2A65A;
  --danger:#E36767;
}
*{box-sizing:border-box; margin:0; padding:0;}
html,body{height:100%;}
body{
  background:var(--bg); color:var(--text);
  font-family:'Inter',sans-serif;
  overflow:hidden;
  -webkit-font-smoothing:antialiased;
}
.mono{font-family:'JetBrains Mono',monospace;}
.display{font-family:'Syne',sans-serif;}
button{font-family:inherit; cursor:pointer;}
input, textarea, select{font-family:inherit;}

#smoke{ position:fixed; inset:0; z-index:0; pointer-events:none; overflow:hidden; }
#smoke .wisp{ position:absolute; border-radius:50%; filter:blur(60px); opacity:0.35; mix-blend-mode:screen; animation:drift 26s ease-in-out infinite; }
#smoke .w1{ width:420px; height:420px; background:var(--accent-soft); top:-10%; left:-8%; animation-duration:32s;}
#smoke .w2{ width:520px; height:520px; background:#3a2f52; bottom:-15%; right:-10%; animation-duration:38s; animation-delay:-8s;}
#smoke .w3{ width:340px; height:340px; background:#26314a; top:40%; left:35%; animation-duration:44s; animation-delay:-18s;}
@keyframes drift{ 0%,100%{ transform:translate(0,0) scale(1); } 50%{ transform:translate(40px,-30px) scale(1.15); } }
@media (prefers-reduced-motion: reduce){ #smoke .wisp{ animation:none; } }

#app{ position:relative; z-index:1; display:flex; height:100vh; }

.sidebar{ width:260px; flex-shrink:0; background:var(--panel); border-right:1px solid var(--border); display:flex; flex-direction:column; padding:20px 16px; }
.logo-row{ display:flex; align-items:center; gap:10px; padding:4px 4px 2px; }
.brand{ font-family:'Syne',sans-serif; font-weight:800; font-size:24px; letter-spacing:0.02em; }
.tagline{ font-size:11px; color:var(--muted); letter-spacing:0.1em; text-transform:uppercase; padding:2px 6px 10px; }
.me-row{ font-size:12px; color:var(--muted); padding:0 6px 16px; display:flex; align-items:center; justify-content:space-between; }
.me-row .logout{ color:var(--accent); background:none; border:none; font-size:11px; font-weight:600; }

nav{ display:flex; flex-direction:column; gap:3px; margin-bottom:18px; }
.nav-btn{ background:transparent; border:none; color:var(--muted); text-align:left; font-weight:600; font-size:14px; padding:10px 12px; border-radius:8px; display:flex; align-items:center; gap:8px; transition:background .15s ease, color .15s ease; }
.nav-btn:hover{ background:var(--panel-alt); color:var(--text); }
.nav-btn.active{ background:var(--accent-dim); color:var(--text); }

.section-label{ font-size:10.5px; color:var(--muted); letter-spacing:0.12em; text-transform:uppercase; padding:0 6px 8px; margin-top:6px; }
.contact-list{ flex:1; overflow-y:auto; display:flex; flex-direction:column; gap:2px; }
.contact-item{ padding:10px 12px; border-radius:8px; font-size:14px; color:var(--text); cursor:pointer; transition:background .15s ease; display:flex; align-items:center; gap:10px; }
.contact-item:hover{ background:var(--panel-alt); }
.contact-item.selected{ background:var(--accent-dim); }
.contact-avatar{ width:28px; height:28px; border-radius:50%; flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700; color:#17151C; }
.btn-secondary{ margin-top:10px; background:var(--panel-alt); border:1px solid var(--border); color:var(--text); font-weight:600; font-size:13px; padding:10px; border-radius:8px; width:100%; transition:border-color .15s ease; }
.btn-secondary:hover{ border-color:var(--accent); }

.btn-primary{ background:var(--accent); border:none; color:#1a1424; font-weight:700; font-size:13px; padding:10px 16px; border-radius:8px; transition:opacity .15s ease; }
.btn-primary:hover{ opacity:0.9; }
.btn-primary:disabled{ opacity:0.4; cursor:not-allowed; }
.btn-ghost{ background:transparent; border:1px solid var(--border); color:var(--muted); font-weight:600; font-size:12.5px; padding:8px 14px; border-radius:8px; }
.btn-ghost:hover{ color:var(--text); border-color:var(--accent); }

.main{ flex:1; display:flex; flex-direction:column; min-width:0; }

.view-header{ display:flex; align-items:center; justify-content:space-between; padding:16px 22px; border-bottom:1px solid var(--border); background:var(--panel); flex-shrink:0; }
.view-header h2{ font-family:'Syne',sans-serif; font-weight:700; font-size:17px; }
.view-header .hint{ font-size:12px; color:var(--muted); }

.empty-state{ flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px; color:var(--muted); text-align:center; padding:40px; }
.empty-state h3{ font-family:'Syne',sans-serif; color:var(--text); font-size:19px; font-weight:700; }

.chat-scroll{ flex:1; overflow-y:auto; padding:18px 22px; display:flex; flex-direction:column; gap:10px; }
.bubble-row{ display:flex; }
.bubble-row.me{ justify-content:flex-end; }
.bubble{ max-width:62%; padding:10px 14px; border-radius:14px; cursor:default; position:relative; }
.bubble.clickable{ cursor:pointer; }
.bubble-row.me .bubble{ background:var(--bubble-me); border-bottom-right-radius:4px; }
.bubble-row:not(.me) .bubble{ background:var(--bubble-them); border-bottom-left-radius:4px; }
.bubble .cipher{ font-family:'JetBrains Mono',monospace; font-size:12.5px; letter-spacing:0.02em; color:var(--accent); animation:flicker 3.5s ease-in-out infinite; }
@keyframes flicker{ 0%,100%{ text-shadow:0 0 6px rgba(185,140,255,0.25); } 50%{ text-shadow:0 0 10px rgba(185,140,255,0.5); } }
.bubble .plain{ font-size:14px; line-height:1.4; }
.bubble .sender{ font-size:10.5px; color:var(--muted); margin-top:4px; text-align:right; }
.bubble-row:not(.me) .sender{ text-align:left; }
.bubble .decode-hint{ font-size:10px; color:var(--muted); margin-top:5px; }
.bubble img.thumb{ max-width:220px; border-radius:8px; display:block; }

.compose{ display:flex; gap:8px; padding:14px 18px; border-top:1px solid var(--border); background:var(--panel); flex-shrink:0; flex-wrap:wrap; }
.compose input[type=text]{ flex:1; min-width:160px; background:var(--panel-alt); border:1px solid var(--border); color:var(--text); padding:11px 14px; border-radius:9px; font-size:14px; }
.compose input[type=text]:focus{ outline:none; border-color:var(--accent); }

.status-list{ flex:1; overflow-y:auto; padding:20px 22px; display:flex; flex-direction:column; gap:12px; }
.status-card{ background:var(--panel); border:1px solid var(--border); border-radius:12px; padding:14px 16px; display:flex; gap:14px; align-items:flex-start; }
.status-card img{ width:64px; height:64px; border-radius:10px; object-fit:cover; flex-shrink:0; }
.status-card .stext{ font-size:14px; line-height:1.5; }
.status-card .sauthor{ font-size:12px; color:var(--accent); font-weight:600; }
.status-card .stime{ font-size:11px; color:var(--muted); margin-top:4px; }

.meeting-hub{ flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16px; }
.meeting-pin-chip{ font-family:'JetBrains Mono',monospace; font-size:13px; color:var(--ok); background:var(--ok-dim); border:1px solid var(--ok); border-radius:20px; padding:4px 14px; }

.modal-backdrop{ position:fixed; inset:0; background:rgba(10,8,14,0.6); backdrop-filter:blur(3px); display:flex; align-items:center; justify-content:center; z-index:50; }
.modal{ background:var(--panel); border:1px solid var(--border); border-radius:14px; padding:26px; width:380px; max-width:90vw; }
.modal h3{ font-family:'Syne',sans-serif; font-size:18px; margin-bottom:6px; }
.modal .modal-sub{ font-size:12.5px; color:var(--muted); margin-bottom:16px; line-height:1.5; }
.modal .field{ margin-bottom:14px; }
.modal .field label{ display:block; font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:6px; }
.modal input[type=text], .modal input[type=password]{ width:100%; background:var(--panel-alt); border:1px solid var(--border); color:var(--text); padding:10px 12px; border-radius:8px; font-size:14px; }
.modal input:focus{ outline:none; border-color:var(--accent); }
.modal .modal-actions{ display:flex; justify-content:flex-end; gap:8px; margin-top:18px; }
.modal .modal-error{ color:var(--danger); font-size:12.5px; margin-top:-6px; margin-bottom:12px; display:none; }
.modal .modal-error.show{ display:block; }

#toast{ position:fixed; bottom:24px; left:50%; transform:translateX(-50%) translateY(20px); background:var(--panel-alt); border:1px solid var(--border); color:var(--text); padding:12px 18px; border-radius:10px; font-size:13.5px; z-index:80; opacity:0; transition:opacity .2s ease, transform .2s ease; pointer-events:none; max-width:80vw; }
#toast.show{ opacity:1; transform:translateX(-50%) translateY(0); }
#toast.error{ border-color:var(--danger); color:var(--danger); }

::-webkit-scrollbar{ width:8px; }
::-webkit-scrollbar-thumb{ background:var(--panel-alt); border-radius:4px; }
::-webkit-scrollbar-track{ background:transparent; }

@media (max-width:720px){ .sidebar{ width:210px; padding:14px 10px; } .bubble{ max-width:80%; } }

/* ---------- AUTH SCREEN ---------- */
#authScreen{ position:relative; z-index:1; height:100vh; display:flex; align-items:center; justify-content:center; }
.auth-card{ width:360px; max-width:90vw; background:var(--panel); border:1px solid var(--border); border-radius:16px; padding:32px; }
.auth-card .brand{ font-size:28px; margin-bottom:4px; }
.auth-card .tagline{ padding:0 0 22px; }
.auth-tabs{ display:flex; gap:6px; margin-bottom:20px; background:var(--panel-alt); border-radius:9px; padding:4px; }
.auth-tab{ flex:1; text-align:center; padding:8px; border-radius:7px; font-size:13px; font-weight:600; color:var(--muted); background:transparent; border:none; }
.auth-tab.active{ background:var(--accent-dim); color:var(--text); }
.auth-card .field{ margin-bottom:14px; }
.auth-card label{ display:block; font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:6px; }
.auth-card input{ width:100%; background:var(--panel-alt); border:1px solid var(--border); color:var(--text); padding:11px 12px; border-radius:8px; font-size:14px; }
.auth-card input:focus{ outline:none; border-color:var(--accent); }
.auth-error{ color:var(--danger); font-size:12.5px; margin-bottom:12px; display:none; }
.auth-error.show{ display:block; }
.auth-card .btn-primary{ width:100%; padding:12px; font-size:14px; margin-top:6px; }
</style>
</head>
<body>

<div id="authScreen">
  <div class="auth-card">
    <div class="brand display">SWIPE</div>
    <div class="tagline">encoded messaging</div>
    <div class="auth-tabs">
      <button class="auth-tab active" data-mode="login">Log In</button>
      <button class="auth-tab" data-mode="register">Sign Up</button>
    </div>
    <div class="auth-error" id="authError"></div>
    <div class="field"><label>Username</label><input type="text" id="authUsername" placeholder="e.g. mahama" autocomplete="username"></div>
    <div class="field"><label>Password</label><input type="password" id="authPassword" placeholder="••••••••" autocomplete="current-password"></div>
    <button class="btn-primary" id="authSubmitBtn">Log In</button>
    <button class="btn-secondary" id="biometricLoginBtn" style="width:100%; margin-top:10px; display:none;">👆 Log in with Face ID / Fingerprint</button>
  </div>
</div>

<div id="smoke" style="display:none;"><div class="wisp w1"></div><div class="wisp w2"></div><div class="wisp w3"></div></div>

<div id="app" style="display:none;">
  <div class="sidebar">
    <div class="logo-row">
      <svg width="40" height="40" viewBox="0 0 60 60" fill="none">
        <line x1="6" y1="20" x2="16" y2="20" stroke="#B98CFF" stroke-width="2.5" stroke-linecap="round" opacity="0.35"/>
        <line x1="9" y1="30" x2="17" y2="30" stroke="#B98CFF" stroke-width="2.5" stroke-linecap="round" opacity="0.55"/>
        <line x1="12" y1="40" x2="18" y2="40" stroke="#B98CFF" stroke-width="2.5" stroke-linecap="round" opacity="0.8"/>
        <path d="M20 22 L20 40 Q20 48 28 48 L40 48 Q46 48 46 40 L46 24 Q46 20 40 22" fill="#B98CFF"/>
        <line x1="22" y1="20" x2="20" y2="6" stroke="#B98CFF" stroke-width="7" stroke-linecap="round"/>
        <line x1="29" y1="17" x2="28" y2="4" stroke="#B98CFF" stroke-width="7" stroke-linecap="round"/>
        <line x1="36" y1="17" x2="37" y2="5" stroke="#B98CFF" stroke-width="7" stroke-linecap="round"/>
        <line x1="43" y1="20" x2="47" y2="9" stroke="#B98CFF" stroke-width="7" stroke-linecap="round"/>
        <line x1="20" y1="24" x2="8" y2="14" stroke="#B98CFF" stroke-width="7" stroke-linecap="round"/>
      </svg>
      <div class="brand">SWIPE</div>
    </div>
    <div class="me-row"><span id="meLabel"></span><button class="logout" id="logoutBtn">Log out</button></div>
    <button class="btn-secondary" id="enableBiometricBtn" style="width:100%; margin:-4px 0 12px; display:none; font-size:12.5px; padding:8px;">👆 Enable Face ID / Fingerprint</button>

    <nav>
      <button class="nav-btn active" data-view="chats">💬 Chats</button>
      <button class="nav-btn" data-view="status">🌀 Status</button>
      <button class="nav-btn" data-view="meeting">🔒 Meeting</button>
      <button class="nav-btn" data-view="admin" id="adminNavBtn" style="display:none;">🛡️ Admin</button>
    </nav>

    <div id="contactsSection">
      <div class="section-label">Contacts</div>
      <div class="contact-list" id="contactList"></div>
      <button class="btn-secondary" id="addContactBtn">+ Add Contact</button>
    </div>
  </div>

  <div class="main" id="main"></div>
</div>

<div id="modalRoot"></div>
<div id="toast"></div>
<input type="file" id="fileInput" accept="image/*" style="display:none;">

<script>
// =====================================================================
// AUTH
// =====================================================================
let authMode = "login";
let token = localStorage.getItem("swipe_token") || null;
let myUsername = localStorage.getItem("swipe_username") || null;
let myIsAdmin = false;
let socket = null;

document.querySelectorAll(".auth-tab").forEach(tab => {
  tab.addEventListener("click", () => {
    authMode = tab.dataset.mode;
    document.querySelectorAll(".auth-tab").forEach(t => t.classList.toggle("active", t === tab));
    document.getElementById("authSubmitBtn").textContent = authMode === "login" ? "Log In" : "Sign Up";
    document.getElementById("authError").classList.remove("show");
  });
});

function showAuthError(msg){
  const el = document.getElementById("authError");
  el.textContent = msg;
  el.classList.add("show");
}

document.getElementById("authSubmitBtn").addEventListener("click", submitAuth);
document.getElementById("authPassword").addEventListener("keydown", e => { if (e.key === "Enter") submitAuth(); });

async function submitAuth(){
  const username = document.getElementById("authUsername").value.trim();
  const password = document.getElementById("authPassword").value;
  if (!username || !password){ showAuthError("Enter a username and password."); return; }
  try{
    const res = await fetch(`/api/${authMode === "login" ? "login" : "register"}`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ username, password })
    });
    const data = await res.json();
    if (!res.ok){ showAuthError(data.error || "Something went wrong."); return; }
    token = data.token;
    myUsername = data.username;
    myIsAdmin = !!data.is_admin;
    localStorage.setItem("swipe_token", token);
    localStorage.setItem("swipe_username", myUsername);
    enterApp();
  }catch(e){
    showAuthError("Couldn't reach the server. Try again.");
  }
}

document.getElementById("enableBiometricBtn").addEventListener("click", enableBiometricLogin);

document.getElementById("logoutBtn").addEventListener("click", () => {
  localStorage.removeItem("swipe_token");
  localStorage.removeItem("swipe_username");
  location.reload();
});

async function tryAutoLogin(){
  if (!token) return;
  try{
    const res = await fetch("/api/me", { headers: { Authorization: `Bearer ${token}` } });
    if (!res.ok) throw new Error("bad token");
    const data = await res.json();
    myUsername = data.username;
    myIsAdmin = !!data.is_admin;
    enterApp();
  }catch(e){
    localStorage.removeItem("swipe_token");
    localStorage.removeItem("swipe_username");
    token = null;
  }
}

function authHeaders(extra){
  return Object.assign({ Authorization: `Bearer ${token}` }, extra || {});
}

function enterApp(){
  document.getElementById("authScreen").style.display = "none";
  document.getElementById("smoke").style.display = "";
  document.getElementById("app").style.display = "flex";
  document.getElementById("meLabel").textContent = "@" + myUsername;

  if (myIsAdmin) {
    document.getElementById("adminNavBtn").style.display = "";
  }

  if (browserSupportsWebAuthn && browserSupportsWebAuthn()){
    document.getElementById("enableBiometricBtn").style.display = "block";
  }

  socket = io({ auth: { token } });
  socket.on("chat:message", ({ message }) => {
    const contact = getContact(currentContactId);
    if (contact && (message.from === contact.username || message.from === "You" && false)){
      // message is for the currently-open chat if it involves the open contact
    }
    if (contact && currentView === "chats" && (message.from === contact.username)){
      appendLiveMessage(message);
    }
    if (contact && currentView === "chats"){
      // also refresh unread indicator could go here
    }
  });
  socket.on("status:new", (s) => {
    if (currentView === "status") prependStatus(s);
  });
  socket.on("meeting:message", (msg) => {
    if (currentView === "meeting" && activeMeeting && msg.sender_username !== myUsername){
      appendLiveMeetingMessage(msg);
    }
  });
  socket.on("meeting:closed", ({ pin }) => {
    if (activeMeeting && activeMeeting.pin === pin) {
      toast("This meeting was closed by the host or an admin.", true);
      activeMeeting = null;
      if (currentView === "meeting") showMeetingView();
    }
  });

  loadContacts();
  showChatsView();
}

tryAutoLogin();

// =====================================================================
// BIOMETRIC LOGIN (Face ID / fingerprint / Windows Hello) via WebAuthn
// The server never receives or stores any biometric data — only a public
// key. Your device does the actual Face ID / fingerprint check locally.
// =====================================================================
const { startRegistration, startAuthentication, browserSupportsWebAuthn } = SimpleWebAuthnBrowser || {};

(async function initBiometricButton(){
  const btn = document.getElementById("biometricLoginBtn");
  if (!browserSupportsWebAuthn || !browserSupportsWebAuthn()) return;
  btn.style.display = "block";
})();

document.getElementById("biometricLoginBtn").addEventListener("click", async () => {
  try {
    const optRes = await fetch("/api/webauthn/login-options", { method: "POST" });
    const options = await optRes.json();
    if (!optRes.ok) { showAuthError(options.error || "Couldn't start biometric login."); return; }

    const authResp = await startAuthentication({ optionsJSON: options });

    const verifyRes = await fetch("/api/webauthn/login-verify", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(authResp)
    });
    const data = await verifyRes.json();
    if (!verifyRes.ok) { showAuthError(data.error || "Biometric login failed."); return; }

    token = data.token;
    myUsername = data.username;
    myIsAdmin = !!data.is_admin;
    localStorage.setItem("swipe_token", token);
    localStorage.setItem("swipe_username", myUsername);
    enterApp();
  } catch (e) {
    // user cancelled the prompt, or no registered device on this browser
    if (e.name !== "NotAllowedError") showAuthError("Biometric login isn't set up on this device yet. Log in with your password, then enable it in settings.");
  }
});

async function enableBiometricLogin(){
  try {
    const optRes = await fetch("/api/webauthn/register-options", { headers: authHeaders() });
    const options = await optRes.json();
    if (!optRes.ok) { toast(options.error || "Couldn't start setup.", true); return; }

    const attResp = await startRegistration({ optionsJSON: options });
    attResp.nickname = prompt("Name this device (e.g. \"My iPhone\"):", "My device") || "My device";

    const verifyRes = await fetch("/api/webauthn/register-verify", {
      method: "POST",
      headers: authHeaders({ "Content-Type": "application/json" }),
      body: JSON.stringify(attResp)
    });
    const data = await verifyRes.json();
    if (!verifyRes.ok) { toast(data.error || "Setup failed.", true); return; }
    toast("Face ID / fingerprint login enabled on this device ✓");
  } catch (e) {
    if (e.name !== "NotAllowedError") toast("Couldn't set up biometric login on this device.", true);
  }
}

// =====================================================================
// CIPHER ENGINE
// Messages are encoded into numbers via a personal math formula (e.g. 2x+1/2).
// Reading them back requires the same formula. This is a fun personal
// obfuscation scheme, not cryptographic-grade security. The server never
// sees the formula or the plaintext — only the encoded numbers.
// =====================================================================
const FORMULA_PATTERN = /^[0-9x.+\-*/^()\s]+$/i;

function validateFormula(str){
  if (!str || !str.trim()) return false;
  return FORMULA_PATTERN.test(str.trim());
}
function evalFormula(formula, xVal){
  return math.evaluate(formula, { x: xVal });
}
function encodeText(text, formula){
  if (!validateFormula(formula)) return { error: "That doesn't look like a valid formula (use only numbers, x, + - * / ^ and parentheses)." };
  try{
    const numbers = [];
    for (const ch of text){
      const code = ch.codePointAt(0);
      const y = Number(evalFormula(formula, code));
      if (!isFinite(y)) return { error: "That formula produced an invalid result — try a simpler one." };
      numbers.push(y);
    }
    return { numbers };
  }catch(e){
    return { error: "Couldn't apply that formula to the message." };
  }
}
function deriveLinearInverse(formula){
  const b = Number(evalFormula(formula, 0));
  const f1 = Number(evalFormula(formula, 1));
  const a = f1 - b;
  const f2 = Number(evalFormula(formula, 2));
  const expected = a * 2 + b;
  if (Math.abs(f2 - expected) > 1e-6) return null;
  if (Math.abs(a) < 1e-12) return null;
  return { a, b };
}
function decodeNumbers(numbers, formula){
  if (!validateFormula(formula)) return { error: "That doesn't look like a valid formula (use only numbers, x, + - * / ^ and parentheses)." };
  let inv;
  try{ inv = deriveLinearInverse(formula); }
  catch(e){ return { error: "Couldn't invert that formula." }; }
  if (!inv) return { error: "This formula can't be reversed — try a simple linear function of x (e.g. 2x+1)." };
  const { a, b } = inv;
  let text = "";
  for (const n of numbers){
    const xVal = Math.round((n - b) / a);
    text += (xVal >= 0 && xVal <= 0x10FFFF) ? String.fromCodePoint(xVal) : "?";
  }
  return { text };
}
function formatNumbers(numbers){
  return numbers.map(n => Number.isInteger(n) ? String(n) : n.toFixed(2)).join(", ");
}

// =====================================================================
// STATE
// =====================================================================
let contacts = [];              // { id, username }
let currentContactId = null;
let currentView = "chats";
let activeMeeting = null;       // { pin, formula }
let lastFormula = "2x+1/2";

const AVATAR_COLORS = ["#B98CFF", "#7FE0C4", "#F2A65A", "#8FA6E8", "#E89CC7", "#6FD6C1"];
function colorFor(id){ return AVATAR_COLORS[id % AVATAR_COLORS.length]; }
function initials(name){ return name.split(" ").map(w => w[0]).slice(0,2).join("").toUpperCase(); }
function getContact(id){ return contacts.find(c => c.id === id); }

// =====================================================================
// TOAST
// =====================================================================
let toastTimer = null;
function toast(msg, isError){
  const el = document.getElementById("toast");
  el.textContent = msg;
  el.className = isError ? "error show" : "show";
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => { el.classList.remove("show"); }, 3200);
}

// =====================================================================
// MODAL SYSTEM
// =====================================================================
function openModal({ title, sub, fields, submitLabel = "OK", onSubmit, onCancel, showCancel = true }){
  const root = document.getElementById("modalRoot");
  const backdrop = document.createElement("div");
  backdrop.className = "modal-backdrop";
  const modal = document.createElement("div");
  modal.className = "modal";

  const h3 = document.createElement("h3");
  h3.textContent = title;
  modal.appendChild(h3);

  if (sub){
    const subEl = document.createElement("div");
    subEl.className = "modal-sub";
    subEl.textContent = sub;
    modal.appendChild(subEl);
  }

  const errorEl = document.createElement("div");
  errorEl.className = "modal-error";
  modal.appendChild(errorEl);

  const inputEls = {};
  (fields || []).forEach(f => {
    const fieldDiv = document.createElement("div");
    fieldDiv.className = "field";
    const label = document.createElement("label");
    label.textContent = f.label;
    const input = document.createElement("input");
    input.type = f.type || "text";
    input.placeholder = f.placeholder || "";
    if (f.value) input.value = f.value;
    input.id = "modalField_" + f.id;
    fieldDiv.appendChild(label);
    fieldDiv.appendChild(input);
    modal.appendChild(fieldDiv);
    inputEls[f.id] = input;
  });

  const actions = document.createElement("div");
  actions.className = "modal-actions";

  function close(){ root.removeChild(backdrop); }

  if (showCancel){
    const cancelBtn = document.createElement("button");
    cancelBtn.className = "btn-ghost";
    cancelBtn.textContent = "Cancel";
    cancelBtn.addEventListener("click", () => { close(); if (onCancel) onCancel(); });
    actions.appendChild(cancelBtn);
  }

  const submitBtn = document.createElement("button");
  submitBtn.className = "btn-primary";
  submitBtn.textContent = submitLabel;
  async function submit(){
    const values = {};
    Object.keys(inputEls).forEach(k => values[k] = inputEls[k].value);
    const result = await onSubmit(values);
    if (result && result.error){
      errorEl.textContent = result.error;
      errorEl.classList.add("show");
      return;
    }
    close();
  }
  submitBtn.addEventListener("click", submit);
  modal.addEventListener("keydown", e => { if (e.key === "Enter" && e.target.tagName === "INPUT") submit(); });
  actions.appendChild(submitBtn);
  modal.appendChild(actions);

  backdrop.appendChild(modal);
  root.appendChild(backdrop);
  if (fields && fields.length) inputEls[fields[0].id].focus();
}

// =====================================================================
// CONTACTS
// =====================================================================
async function loadContacts(){
  try{
    const res = await fetch("/api/contacts", { headers: authHeaders() });
    const data = await res.json();
    contacts = data.contacts || [];
    renderContactList();
  }catch(e){ toast("Couldn't load contacts.", true); }
}

function renderContactList(){
  const list = document.getElementById("contactList");
  list.innerHTML = "";
  if (!contacts.length){
    const empty = document.createElement("div");
    empty.style.cssText = "color:var(--muted); font-size:12.5px; padding:8px;";
    empty.textContent = "No contacts yet. Add a friend by their username.";
    list.appendChild(empty);
  }
  contacts.forEach(c => {
    const item = document.createElement("div");
    item.className = "contact-item" + (c.id === currentContactId ? " selected" : "");
    item.innerHTML = `<div class="contact-avatar" style="background:${colorFor(c.id)}">${initials(c.username)}</div><span>${c.username}</span>`;
    item.addEventListener("click", () => {
      currentContactId = c.id;
      currentView = "chats";
      setActiveNav("chats");
      renderContactList();
      renderChatView(c);
    });
    list.appendChild(item);
  });
}

function setActiveNav(view){
  document.querySelectorAll(".nav-btn").forEach(b => b.classList.toggle("active", b.dataset.view === view));
}

// =====================================================================
// VIEW ROUTING
// =====================================================================
function showChatsView(){
  currentView = "chats";
  const contact = getContact(currentContactId);
  if (contact){ renderChatView(contact); return; }
  const main = document.getElementById("main");
  main.innerHTML = `<div class="empty-state">
    <h3>Select a contact</h3>
    <div>Pick someone from the list to start an encoded conversation.</div>
  </div>`;
}

function showStatusView(){
  currentView = "status";
  const main = document.getElementById("main");
  main.innerHTML = `
    <div class="view-header">
      <h2>Status Updates</h2>
      <button class="btn-primary" id="addStatusBtn">+ Add Status</button>
    </div>
    <div class="status-list" id="statusList"></div>`;
  document.getElementById("addStatusBtn").addEventListener("click", promptAddStatus);
  loadStatuses();
}

async function loadStatuses(){
  const list = document.getElementById("statusList");
  list.innerHTML = `<div class="empty-state"><h3>Loading…</h3></div>`;
  try{
    const res = await fetch("/api/statuses", { headers: authHeaders() });
    const data = await res.json();
    renderStatusList(data.statuses || []);
  }catch(e){ toast("Couldn't load statuses.", true); }
}

function renderStatusList(statuses){
  const list = document.getElementById("statusList");
  if (!list) return;
  if (!statuses.length){
    list.innerHTML = `<div class="empty-state"><h3>No status yet</h3><div>Share a thought or a photo with your contacts.</div></div>`;
    return;
  }
  list.innerHTML = "";
  statuses.forEach(s => list.appendChild(statusCardEl(s)));
}
function statusCardEl(s){
  const card = document.createElement("div");
  card.className = "status-card";
  const time = new Date(s.created_at).toLocaleString([], { day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit" });
  card.innerHTML = `
    ${s.image ? `<img src="${s.image}">` : ""}
    <div>
      <div class="sauthor">@${s.username}</div>
      <div class="stext">${escapeHtml(s.text)}</div>
      <div class="stime">${time}</div>
    </div>`;
  return card;
}
function prependStatus(s){
  const list = document.getElementById("statusList");
  if (!list) return;
  if (list.querySelector(".empty-state")) list.innerHTML = "";
  list.insertBefore(statusCardEl(s), list.firstChild);
}

function showMeetingView(){
  currentView = "meeting";
  const main = document.getElementById("main");
  if (activeMeeting){ renderMeetingChat(); return; }
  main.innerHTML = `
    <div class="meeting-hub">
      <h3 class="display" style="font-size:20px;">Secure Meeting</h3>
      <div style="color:var(--muted); font-size:13px; text-align:center; max-width:320px;">
        Host a meeting with a PIN + one-time formula, or join one that's already running.
        Share the PIN and formula with your friends outside the app.
      </div>
      <div style="display:flex; gap:10px; margin-top:8px;">
        <button class="btn-primary" id="hostMeetingBtn">Host Meeting</button>
        <button class="btn-ghost" id="joinMeetingBtn">Join Meeting</button>
      </div>
    </div>`;
  document.getElementById("hostMeetingBtn").addEventListener("click", hostMeeting);
  document.getElementById("joinMeetingBtn").addEventListener("click", joinMeeting);
}

// =====================================================================
// ADMIN VIEW — meeting access request queue
// =====================================================================
function showAdminView(){
  currentView = "admin";
  const main = document.getElementById("main");
  main.innerHTML = `
    <div class="view-header">
      <h2>🛡️ Admin — Meeting Access Requests</h2>
      <button class="btn-ghost" id="refreshRequestsBtn">Refresh</button>
    </div>
    <div id="requestsList" style="padding:16px;"><div class="empty-state"><h3>Loading…</h3></div></div>`;
  document.getElementById("refreshRequestsBtn").addEventListener("click", loadAccessRequests);
  loadAccessRequests();
}

async function loadAccessRequests(){
  const list = document.getElementById("requestsList");
  try{
    const res = await fetch("/api/admin/meeting-requests", { headers: authHeaders() });
    const data = await res.json();
    if (!res.ok) { list.innerHTML = `<div class="empty-state"><h3>${data.error || "Couldn't load requests."}</h3></div>`; return; }
    renderAccessRequests(data.requests || []);
  }catch(e){
    list.innerHTML = `<div class="empty-state"><h3>Couldn't reach the server.</h3></div>`;
  }
}

function renderAccessRequests(requests){
  const list = document.getElementById("requestsList");
  if (!list) return;
  if (!requests.length){
    list.innerHTML = `<div class="empty-state"><h3>No pending requests</h3><div>Nobody is currently waiting for access to a closed meeting.</div></div>`;
    return;
  }
  list.innerHTML = "";
  requests.forEach(r => {
    const row = document.createElement("div");
    row.style.cssText = "display:flex; align-items:center; justify-content:space-between; gap:12px; padding:12px 14px; border:1px solid var(--border); border-radius:10px; margin-bottom:8px; background:var(--panel-alt);";
    const time = new Date(r.created_at).toLocaleString([], { day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit" });
    row.innerHTML = `
      <div>
        <div style="font-weight:600;">@${escapeHtml(r.requester_username)}</div>
        <div class="hint">wants back into meeting PIN <strong>${escapeHtml(r.pin)}</strong> · ${time}</div>
      </div>
      <div style="display:flex; gap:8px;">
        <button class="btn-primary" data-action="approve" data-id="${r.id}">Approve</button>
        <button class="btn-ghost" data-action="deny" data-id="${r.id}" style="color:var(--danger,#e5555a);">Delete</button>
        <button class="btn-ghost" data-action="reopen-all" data-pin="${escapeHtml(r.pin)}">Let Everyone Back In</button>
      </div>`;
    row.querySelector('[data-action="approve"]').addEventListener("click", () => resolveRequest(r.id, true));
    row.querySelector('[data-action="deny"]').addEventListener("click", () => resolveRequest(r.id, false));
    row.querySelector('[data-action="reopen-all"]').addEventListener("click", () => reopenMeetingForAll(r.pin));
    list.appendChild(row);
  });
}

async function reopenMeetingForAll(pin){
  if (!confirm(`Let everyone who was ever in meeting PIN ${pin} back in, without reviewing each request individually?`)) return;
  try{
    const res = await fetch(`/api/admin/meetings/${encodeURIComponent(pin)}/reopen-for-all`, {
      method: "POST",
      headers: authHeaders()
    });
    const data = await res.json();
    if (!res.ok) { toast(data.error || "Couldn't reopen for everyone.", true); return; }
    toast(`Reopened for ${data.approved_count} past participant(s).`);
    loadAccessRequests();
  }catch(e){
    toast("Couldn't reach the server.", true);
  }
}

async function resolveRequest(id, approve){
  try{
    const res = await fetch(`/api/admin/meeting-requests/${id}/${approve ? "approve" : "deny"}`, {
      method: "POST",
      headers: authHeaders()
    });
    const data = await res.json();
    if (!res.ok) { toast(data.error || "Couldn't update that request.", true); return; }
    toast(approve ? "Access approved." : "Request deleted.");
    loadAccessRequests();
  }catch(e){
    toast("Couldn't reach the server.", true);
  }
}

document.querySelectorAll(".nav-btn").forEach(btn => {
  btn.addEventListener("click", () => {
    setActiveNav(btn.dataset.view);
    if (btn.dataset.view === "chats") showChatsView();
    else if (btn.dataset.view === "status") showStatusView();
    else if (btn.dataset.view === "admin") showAdminView();
    else showMeetingView();
  });
});
document.getElementById("addContactBtn").addEventListener("click", () => {
  openModal({
    title: "Add Contact",
    sub: "Enter their exact SWIPE username.",
    fields: [{ id: "username", label: "Username", placeholder: "e.g. ama" }],
    submitLabel: "Add",
    onSubmit: async (v) => {
      if (!v.username.trim()) return { error: "Enter a username." };
      try{
        const res = await fetch("/api/contacts", {
          method: "POST",
          headers: authHeaders({ "Content-Type": "application/json" }),
          body: JSON.stringify({ username: v.username.trim() })
        });
        const data = await res.json();
        if (!res.ok) return { error: data.error || "Couldn't add contact." };
        if (socket) socket.emit("contact:added", data.contact.id);
        await loadContacts();
        toast(`Added @${data.contact.username}.`);
      }catch(e){
        return { error: "Couldn't reach the server." };
      }
    }
  });
});

// =====================================================================
// CHAT VIEW
// =====================================================================
async function renderChatView(contact){
  const main = document.getElementById("main");
  main.innerHTML = `
    <div class="view-header">
      <h2>@${contact.username}</h2>
      <span class="hint">tap a message to decode it</span>
    </div>
    <div class="chat-scroll" id="chatScroll"><div class="empty-state"><h3>Loading…</h3></div></div>
    <div class="compose">
      <input type="text" id="msgInput" placeholder="Type a message…">
      <button class="btn-ghost" id="mediaBtn">📎 Photo</button>
      <button class="btn-primary" id="sendBtn">Send</button>
    </div>`;

  const input = document.getElementById("msgInput");
  document.getElementById("sendBtn").addEventListener("click", () => sendText(contact, input));
  input.addEventListener("keydown", e => { if (e.key === "Enter") sendText(contact, input); });
  document.getElementById("mediaBtn").addEventListener("click", () => sendMedia(contact));

  try{
    const res = await fetch(`/api/messages/${encodeURIComponent(contact.username)}`, { headers: authHeaders() });
    const data = await res.json();
    const scroll = document.getElementById("chatScroll");
    scroll.innerHTML = "";
    (data.messages || []).forEach(msg => scroll.appendChild(renderBubble(msg)));
    scroll.scrollTop = scroll.scrollHeight;
  }catch(e){ toast("Couldn't load messages.", true); }
}

function appendLiveMessage(msg){
  const scroll = document.getElementById("chatScroll");
  if (!scroll) return;
  scroll.appendChild(renderBubble(msg));
  scroll.scrollTop = scroll.scrollHeight;
}

function renderBubble(msg){
  const row = document.createElement("div");
  row.className = "bubble-row" + (msg.from === "You" || msg.from === myUsername ? " me" : "");
  const bubble = document.createElement("div");
  bubble.className = "bubble" + (msg.kind === "text" ? " clickable" : "");

  if (msg.kind === "text"){
    bubble.innerHTML = `<div class="cipher">🔢 ${formatNumbers(msg.numbers)}</div>
      <div class="decode-hint">click to decode</div>
      <div class="sender">${msg.from}</div>`;
    bubble.addEventListener("click", () => revealMessage(msg));
  } else if (msg.kind === "image"){
    bubble.innerHTML = `<img class="thumb" src="${msg.image}"><div class="sender">${msg.from}</div>`;
  }
  row.appendChild(bubble);
  return row;
}

function sendText(contact, input){
  const text = input.value.trim();
  if (!text) return;
  openModal({
    title: "Encode with formula",
    sub: "Enter the formula to encode this message (e.g. 2x+1/2). Your friend needs the same formula to read it.",
    fields: [{ id: "formula", label: "Formula", placeholder: "2x+1/2", value: lastFormula }],
    submitLabel: "Encode & Send",
    onSubmit: async (v) => {
      const { numbers, error } = encodeText(text, v.formula);
      if (error) return { error };
      lastFormula = v.formula;
      try{
        const res = await fetch("/api/messages", {
          method: "POST",
          headers: authHeaders({ "Content-Type": "application/json" }),
          body: JSON.stringify({ to: contact.username, numbers, kind: "text" })
        });
        const data = await res.json();
        if (!res.ok) return { error: data.error || "Couldn't send." };
        input.value = "";
        appendLiveMessage(data.message);
      }catch(e){
        return { error: "Couldn't reach the server." };
      }
    }
  });
}

function sendMedia(contact){
  const fileInput = document.getElementById("fileInput");
  fileInput.onchange = () => {
    const file = fileInput.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = async () => {
      try{
        const res = await fetch("/api/messages", {
          method: "POST",
          headers: authHeaders({ "Content-Type": "application/json" }),
          body: JSON.stringify({ to: contact.username, kind: "image", image: reader.result })
        });
        const data = await res.json();
        if (!res.ok){ toast(data.error || "Couldn't send photo.", true); return; }
        appendLiveMessage(data.message);
      }catch(e){ toast("Couldn't reach the server.", true); }
    };
    reader.readAsDataURL(file);
    fileInput.value = "";
  };
  fileInput.click();
}

function revealMessage(msg){
  openModal({
    title: "Decode message",
    sub: "Enter the formula to decode this message.",
    fields: [{ id: "formula", label: "Formula", placeholder: "2x+1/2", value: lastFormula }],
    submitLabel: "Decode",
    onSubmit: (v) => {
      const { text, error } = decodeNumbers(msg.numbers, v.formula);
      if (error) return { error };
      toast(`Decoded: ${text}`);
    }
  });
}

// =====================================================================
// STATUS
// =====================================================================
function promptAddStatus(){
  openModal({
    title: "Add Status",
    fields: [{ id: "text", label: "What's on your mind?", placeholder: "Share something…" }],
    submitLabel: "Next",
    onSubmit: (v) => {
      if (!v.text.trim()) return { error: "Say something first." };
      promptStatusImage(v.text.trim());
    }
  });
}
function promptStatusImage(text){
  const fileInput = document.getElementById("fileInput");
  const finish = async (image) => {
    try{
      const res = await fetch("/api/statuses", {
        method: "POST",
        headers: authHeaders({ "Content-Type": "application/json" }),
        body: JSON.stringify({ text, image })
      });
      if (!res.ok){ const d = await res.json(); toast(d.error || "Couldn't post status.", true); return; }
      toast("Status posted.");
    }catch(e){ toast("Couldn't reach the server.", true); }
  };
  openModal({
    title: "Attach a photo?",
    sub: "Optional — add a photo to this status.",
    fields: [],
    submitLabel: "Choose Photo",
    showCancel: true,
    onCancel: () => finish(null),
    onSubmit: () => {
      fileInput.onchange = () => {
        const file = fileInput.files[0];
        if (!file) { finish(null); return; }
        const reader = new FileReader();
        reader.onload = () => finish(reader.result);
        reader.readAsDataURL(file);
        fileInput.value = "";
      };
      fileInput.click();
      return { error: null };
    }
  });
}

// =====================================================================
// MEETINGS
// =====================================================================
function hostMeeting(){
  openModal({
    title: "Host Meeting",
    fields: [
      { id: "pin", label: "Set a PIN (4+ characters)", placeholder: "1234" },
      { id: "cap", label: "Max people allowed to join (optional)", placeholder: "Leave blank for no limit" },
    ],
    submitLabel: "Next",
    onSubmit: (v) => {
      if (!v.pin || v.pin.trim().length < 4) return { error: "PIN must be at least 4 characters." };
      let cap = null;
      if (v.cap && v.cap.trim()) {
        cap = parseInt(v.cap.trim(), 10);
        if (!Number.isInteger(cap) || cap < 1) return { error: "Max people must be a whole number of 1 or more." };
      }
      const pin = v.pin.trim();
      openModal({
        title: "One-Time Formula",
        sub: "Set the formula for this meeting (e.g. 2x+1/2). This never leaves your device — share it with participants yourself.",
        fields: [{ id: "formula", label: "Formula", placeholder: "2x+1/2" }],
        submitLabel: "Start Meeting",
        onSubmit: async (v2) => {
          if (!validateFormula(v2.formula)) return { error: "Enter a valid formula (numbers, x, + - * / ^)." };
          try{
            const res = await fetch("/api/meetings", {
              method: "POST",
              headers: authHeaders({ "Content-Type": "application/json" }),
              body: JSON.stringify({ pin, max_participants: cap })
            });
            const data = await res.json();
            if (!res.ok) return { error: data.error || "Couldn't start meeting." };
            activeMeeting = { pin, formula: v2.formula.trim(), rendered: new Set(), isHost: true, maxParticipants: cap };
            socket.emit("meeting:join", pin);
            toast("Meeting is live. Share the PIN and formula with your friends.");
            if (currentView === "meeting") showMeetingView();
          }catch(e){
            return { error: "Couldn't reach the server." };
          }
        }
      });
    }
  });
}
function joinMeeting(){
  openModal({
    title: "Join Meeting",
    fields: [{ id: "pin", label: "Meeting PIN", placeholder: "" }],
    submitLabel: "Next",
    onSubmit: async (v) => {
      const pin = v.pin.trim();
      try{
        const res = await fetch(`/api/meetings/${encodeURIComponent(pin)}/join`, {
          method: "POST",
          headers: authHeaders()
        });
        const data = await res.json();
        if (!res.ok) {
          if (data.closed) {
            offerRequestAccess(pin);
            return { error: "This meeting is closed. Check the request you just sent, or ask the host/admin." };
          }
          if (data.full) {
            return { error: "This meeting is full. Ask the host to raise the limit or reset it." };
          }
          return { error: data.error || "Couldn't join meeting." };
        }
        openModal({
          title: "One-Time Formula",
          sub: "Enter the meeting's formula (get it from whoever is hosting).",
          fields: [{ id: "formula", label: "Formula", placeholder: "2x+1/2" }],
          submitLabel: "Join",
          onSubmit: (v2) => {
            if (!validateFormula(v2.formula)) return { error: "Enter a valid formula." };
            activeMeeting = { pin, formula: v2.formula.trim(), rendered: new Set(), isHost: false };
            socket.emit("meeting:join", pin);
            toast("You're in. Messages decode automatically for the rest of this meeting.");
            if (currentView === "meeting") showMeetingView();
          }
        });
      }catch(e){
        return { error: "Couldn't reach the server." };
      }
    }
  });
}

// Called when a join attempt hits a closed meeting. Fires the request
// immediately (idempotent server-side — repeat clicks won't spam duplicates)
// so the person doesn't have to find a separate button for it.
async function offerRequestAccess(pin){
  try{
    const res = await fetch(`/api/meetings/${encodeURIComponent(pin)}/request-access`, {
      method: "POST",
      headers: authHeaders()
    });
    if (res.ok) {
      toast("Access request sent. An admin will need to approve it before you can rejoin.");
    } else {
      const data = await res.json();
      toast(data.error || "Couldn't send the access request.", true);
    }
  }catch(e){
    toast("Couldn't reach the server to send the request.", true);
  }
}
async function renderMeetingChat(){
  const main = document.getElementById("main");
  const canManage = activeMeeting.isHost || myIsAdmin;
  main.innerHTML = `
    <div class="view-header">
      <div style="display:flex; align-items:center; gap:10px;">
        <h2>🔒 Secure Meeting</h2>
        <span class="meeting-pin-chip">PIN ${activeMeeting.pin}</span>
        <span class="hint">unlocked for this session</span>
      </div>
      <div style="display:flex; gap:8px;">
        ${canManage ? `<button class="btn-ghost" id="closeMeetingBtn" style="color:var(--danger,#e5555a);">Close Meeting</button>` : ""}
        <button class="btn-ghost" id="endMeetingBtn">Leave Meeting</button>
      </div>
    </div>
    ${canManage ? `
    <div style="display:flex; align-items:center; gap:10px; padding:10px 16px; border-bottom:1px solid var(--border); font-size:13px;">
      <span class="hint" id="capacityStatus">Checking capacity…</span>
      <button class="btn-ghost" id="setCapacityBtn" style="padding:4px 10px; font-size:12px;">Set Limit</button>
      <button class="btn-ghost" id="resetCapacityBtn" style="padding:4px 10px; font-size:12px;">Reset Count</button>
    </div>` : ""}
    <div class="chat-scroll" id="meetingScroll"><div class="empty-state"><h3>Loading…</h3></div></div>
    <div class="compose">
      <input type="text" id="meetingInput" placeholder="Type a message…">
      <button class="btn-primary" id="meetingSendBtn">Send</button>
    </div>`;

  const input = document.getElementById("meetingInput");
  document.getElementById("meetingSendBtn").addEventListener("click", () => sendMeetingMessage(input));
  input.addEventListener("keydown", e => { if (e.key === "Enter") sendMeetingMessage(input); });
  document.getElementById("endMeetingBtn").addEventListener("click", () => {
    activeMeeting = null;
    showMeetingView();
  });
  if (canManage) {
    document.getElementById("closeMeetingBtn").addEventListener("click", async () => {
      if (!confirm("Close this meeting? Nobody — including you — will be able to rejoin without an admin approving a request.")) return;
      try{
        const res = await fetch(`/api/meetings/${encodeURIComponent(activeMeeting.pin)}/close`, {
          method: "POST",
          headers: authHeaders()
        });
        const data = await res.json();
        if (!res.ok) { toast(data.error || "Couldn't close the meeting.", true); return; }
        toast("Meeting closed. Only an admin can let anyone back in now.");
        activeMeeting = null;
        showMeetingView();
      }catch(e){
        toast("Couldn't reach the server.", true);
      }
    });
    document.getElementById("setCapacityBtn").addEventListener("click", () => {
      openModal({
        title: "Set Join Limit",
        sub: "Once this many people have joined, nobody else can get in until you reset the count.",
        fields: [{ id: "cap", label: "Max people (leave blank for no limit)", placeholder: "e.g. 10" }],
        submitLabel: "Save",
        onSubmit: async (v) => {
          let cap = null;
          if (v.cap && v.cap.trim()) {
            cap = parseInt(v.cap.trim(), 10);
            if (!Number.isInteger(cap) || cap < 1) return { error: "Enter a whole number of 1 or more." };
          }
          try{
            const res = await fetch(`/api/meetings/${encodeURIComponent(activeMeeting.pin)}/capacity`, {
              method: "PATCH",
              headers: authHeaders({ "Content-Type": "application/json" }),
              body: JSON.stringify({ max_participants: cap })
            });
            const data = await res.json();
            if (!res.ok) return { error: data.error || "Couldn't update the limit." };
            toast(cap ? `Join limit set to ${cap}.` : "Join limit removed.");
            refreshCapacityStatus();
          }catch(e){
            return { error: "Couldn't reach the server." };
          }
        }
      });
    });
    document.getElementById("resetCapacityBtn").addEventListener("click", async () => {
      if (!confirm("Reset the headcount? This lets new people join again up to the same limit.")) return;
      try{
        const res = await fetch(`/api/meetings/${encodeURIComponent(activeMeeting.pin)}/reset-capacity`, {
          method: "POST",
          headers: authHeaders()
        });
        const data = await res.json();
        if (!res.ok) { toast(data.error || "Couldn't reset.", true); return; }
        toast("Headcount reset.");
        refreshCapacityStatus();
      }catch(e){
        toast("Couldn't reach the server.", true);
      }
    });
    refreshCapacityStatus();
  }

  try{
    const res = await fetch(`/api/meetings/${encodeURIComponent(activeMeeting.pin)}/messages`, { headers: authHeaders() });
    const data = await res.json();
    if (!res.ok) {
      if (data.closed) {
        toast("This meeting was just closed.", true);
        activeMeeting = null;
        showMeetingView();
        return;
      }
      toast(data.error || "Couldn't load meeting history.", true);
      return;
    }
    const scroll = document.getElementById("meetingScroll");
    scroll.innerHTML = "";
    (data.messages || []).forEach(msg => {
      activeMeeting.rendered.add(msg.id);
      scroll.appendChild(meetingBubbleEl(msg));
    });
    scroll.scrollTop = scroll.scrollHeight;
  }catch(e){ toast("Couldn't load meeting history.", true); }
}
function meetingBubbleEl(msg){
  const { text } = decodeNumbers(msg.numbers, activeMeeting.formula);
  const row = document.createElement("div");
  row.className = "bubble-row" + (msg.sender_username === myUsername ? " me" : "");
  const bubble = document.createElement("div");
  bubble.className = "bubble";
  bubble.innerHTML = `<div class="plain">${escapeHtml(text || "")}</div><div class="sender">${msg.sender_username}</div>`;
  row.appendChild(bubble);
  return row;
}
function appendLiveMeetingMessage(msg){
  if (activeMeeting.rendered.has(msg.id)) return;
  activeMeeting.rendered.add(msg.id);
  const scroll = document.getElementById("meetingScroll");
  if (!scroll) return;
  scroll.appendChild(meetingBubbleEl(msg));
  scroll.scrollTop = scroll.scrollHeight;
}
async function refreshCapacityStatus(){
  const el = document.getElementById("capacityStatus");
  if (!el || !activeMeeting) return;
  try{
    const res = await fetch(`/api/meetings/${encodeURIComponent(activeMeeting.pin)}/capacity`, { headers: authHeaders() });
    const data = await res.json();
    if (!res.ok) { el.textContent = "Couldn't load capacity."; return; }
    el.textContent = data.max_participants
      ? `${data.participant_count} / ${data.max_participants} joined`
      : `${data.participant_count} joined · no limit set`;
  }catch(e){
    el.textContent = "Couldn't load capacity.";
  }
}

async function sendMeetingMessage(input){
  const text = input.value.trim();
  if (!text) return;
  const { numbers, error } = encodeText(text, activeMeeting.formula);
  if (error){ toast(error, true); return; }
  try{
    const res = await fetch(`/api/meetings/${encodeURIComponent(activeMeeting.pin)}/messages`, {
      method: "POST",
      headers: authHeaders({ "Content-Type": "application/json" }),
      body: JSON.stringify({ numbers })
    });
    const data = await res.json();
    if (!res.ok){
      toast(data.error || "Couldn't send.", true);
      if (data.closed) { activeMeeting = null; showMeetingView(); }
      return;
    }
    input.value = "";
    activeMeeting.rendered.add(data.message.id);
    const scroll = document.getElementById("meetingScroll");
    scroll.appendChild(meetingBubbleEl(data.message));
    scroll.scrollTop = scroll.scrollHeight;
  }catch(e){ toast("Couldn't reach the server.", true); }
}

// =====================================================================
// UTIL
// =====================================================================
function escapeHtml(str){
  const div = document.createElement("div");
  div.textContent = str;
  return div.innerHTML;
}
</script>
</body>
</html>
