# Copy this file to .env for local development (never commit the real .env).
# On Render, set these in Dashboard → your service → Environment.

# Secret used to sign login sessions. Use a long random string in production.
JWT_SECRET=change-this-to-something-long-and-random

# MongoDB Atlas connection string (Database → Connect → Drivers → Node.js).
# Example: mongodb+srv://Swipeadmin:<password>@swipecluster.xxxxx.mongodb.net/swipe
MONGODB_URI=

# --- Needed for Face ID / fingerprint (WebAuthn) login ---
# RP_ID must be your bare domain, no https:// and no trailing slash.
# Local dev:  RP_ID=localhost
# Production: RP_ID=swipe-app-wzqp.onrender.com
RP_ID=localhost

# ORIGIN must be the FULL url including https://, no trailing slash.
# Local dev:  ORIGIN=http://localhost:3000
# Production: ORIGIN=https://swipe-app-wzqp.onrender.com
ORIGIN=http://localhost:3000

# Username that automatically gets admin rights on login. Defaults to
# "mahama245" if unset.
BOOTSTRAP_ADMIN_USERNAME=mahama245
